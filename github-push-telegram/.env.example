TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Lista separada por comas: usuario/repositorio,organizacion/otro-repo
# Vacío = acepta pushes de cualquier repositorio que apunte a este webhook.
GITHUB_REPOS=usuario/repositorio,usuario/repositorio-principal

# Vacío = todas las ramas. Por defecto solo main y master.
WATCHED_BRANCHES=main,master

# El mismo secreto se configura en GitHub > Settings > Webhooks.
GITHUB_WEBHOOK_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

PORT=8080
WEBHOOK_PATH=/github/webhook
LOG_LEVEL=INFO

# Opcional: avisos de despliegue. Railway manda este secreto en Authorization: Bearer ...
# Genera al menos 32 caracteres aleatorios y guardalos fuera del repositorio.
RAILWAY_WEBHOOK_SECRET=
# UUID de los proyectos permitidos, separados por comas. Obligatorio si se activa Railway.
RAILWAY_PROJECT_IDS=
RAILWAY_ENVIRONMENTS=production
